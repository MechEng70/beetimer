# Android signing: NEVER commit. Back up the keystore and passwords somewhere other than GitHub.
*.jks
*.keystore
keystore.properties
signing/

# Gradle and build output
.gradle/
build/
.kotlin/
captures/
*.apk
*.aab
release/

# Machine-specific
local.properties
.idea/
*.iml
.DS_Store
.env
*.env

# docs/screenshots/ is committed: app and mockup captures only, status bar cropped off
# (it shows other apps' icons and the repo is public). Raw captures stay out:
docs/screenshots/raw/

# Agent worktrees and Claude Code's local settings
.claude/worktrees/
.claude/settings.local.json

# E2E: raw Maestro debug output (key screenshots, logs and transcripts are kept)
docs/e2e/*/maestro/
__pycache__/
